# What dr-sync excludes when syncing $HERMES_HOME with the Files API
# container (see docker/entrypoint.sh and README.md's "Persisting state
# across restarts"). Gitignore syntax.

# Baked from the image seed on every boot -- a stale download must never
# overwrite the version the current image just shipped.
/config.yaml
/SOUL.md
/slack-manifest.json
/skills/
/plugins/
/.drsyncignore

# Only present in an image built with WITH_BROWSER_USE=1: a restored uv tool
# venv from an older image must not replace the one baked into this one.
/bin/
/.local/share/uv/tools/

# Regenerated from a template every boot (see docker/entrypoint.sh); a
# restored copy would carry a stale DATAROBOT_API_TOKEN from a previous boot.
/hermes_otel.yaml
/hermes_otel.yaml.tmpl

# Regenerable caches and pure logs. No value in persisting them, and the
# image/audio caches in particular can grow large fast.
/logs/
/cache/
/audio_cache/
/image_cache/
/lazy-packages/
