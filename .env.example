# Copy to .env and fill in. .env is gitignored and never baked into the image.
# `dr workload config` turns it into DataRobot credentials for the deployed workload.

# Secrets
LLM_API_KEY=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional: the DataRobot LLM gateway is the default. Override to use another
# chat_completions gateway.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_PROVIDER=

# Optional: Slack access and the channel for notifications.
# SLACK_ALLOWED_USERS=
# SLACK_HOME_CHANNEL=

# Keep sessions and memory across restarts. `dr start` asks, then
# creates the workload's dr-sync state store and sets its id here
# (docs/ARCHITECTURE.md, "Turning persistence on").
# PERSIST_STATE=yes
# DR_SYNC_CATALOG_ID=

# Needed by dr-sync and trace export. A deployed workload gets its own key
# injected, so this is for local runs only.
# DATAROBOT_API_TOKEN=
# DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
